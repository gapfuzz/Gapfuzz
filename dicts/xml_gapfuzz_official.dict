################################################################################
#
# AFL dictionary for XML
# ----------------------
#
# Several basic syntax elements and attributes, modeled on libxml2.
#
# Created by Michal Zalewski <lcamtuf@google.com>
#

attr_encoding=" encoding=\"1\""
attr_generic=" a=\"1\""
attr_href=" href=\"1\""
attr_standalone=" standalone=\"no\""
attr_version=" version=\"1\""
attr_xml_base=" xml:base=\"1\""
attr_xml_id=" xml:id=\"1\""
attr_xml_lang=" xml:lang=\"1\""
attr_xml_space=" xml:space=\"1\""
attr_xmlns=" xmlns=\"1\""

entity_builtin="&lt;"
entity_decimal="&#1;"
entity_external="&a;"
entity_hex="&#x1;"

string_any="ANY"
string_brackets="[]"
string_cdata="CDATA"
string_col_fallback=":fallback"
string_col_generic=":a"
string_col_include=":include"
string_dashes="--"
string_empty="EMPTY"
string_empty_dblquotes="\"\""
string_empty_quotes="''"
string_entities="ENTITIES"
string_entity="ENTITY"
string_fixed="#FIXED"
string_id="ID"
string_idref="IDREF"
string_idrefs="IDREFS"
string_implied="#IMPLIED"
string_nmtoken="NMTOKEN"
string_nmtokens="NMTOKENS"
string_notation="NOTATION"
string_parentheses="()"
string_pcdata="#PCDATA"
string_percent="%a"
string_public="PUBLIC"
string_required="#REQUIRED"
string_schema=":schema"
string_system="SYSTEM"
string_ucs4="UCS-4"
string_utf16="UTF-16"
string_utf8="UTF-8"
string_xmlns="xmlns:"

tag_attlist="<!ATTLIST"
tag_cdata="<![CDATA["
tag_close="</a>"
tag_doctype="<!DOCTYPE"
tag_element="<!ELEMENT"
tag_entity="<!ENTITY"
tag_ignore="<![IGNORE["
tag_include="<![INCLUDE["
tag_notation="<!NOTATION"
tag_open="<a>"
tag_open_close="<a />"
tag_open_exclamation="<!"
tag_open_q="<?"
tag_sq2_close="]]>"
tag_xml_q="<?xml?>"

# --- gapfuzz가 추가한 토큰
# 바이트 조합: tinyxml2.cpp:400 *(pu+1) == TIXML_UTF_LEAD_1; tinyxml2.cpp:401 *(pu+2) == TIXML_UTF_LEAD_2
gapfuzz_1="\xEF\xBB\xBF"
# 문자: tinyxml2.cpp:470 *(p + 1) == '#'
gapfuzz_2="#"
# 숫자 경계: tinyxml2.cpp:422 input < 0x10000
gapfuzz_3="10000"
# 숫자 경계: tinyxml2.cpp:422 input < 0x10000
gapfuzz_4="10001"
# 숫자 경계: tinyxml2.cpp:539 ucs > MAX_CODE_POINT
gapfuzz_5="10fffe"
# 숫자 경계: tinyxml2.cpp:539 ucs > MAX_CODE_POINT
gapfuzz_6="10ffff"
# 숫자 경계: tinyxml2.cpp:539 ucs > MAX_CODE_POINT
gapfuzz_7="110000"
# 숫자 경계: tinyxml2.cpp:539 ucs > MAX_CODE_POINT
gapfuzz_8="1114110"
# 숫자 경계: tinyxml2.cpp:539 ucs > MAX_CODE_POINT
gapfuzz_9="1114111"
# 숫자 경계: tinyxml2.cpp:539 ucs > MAX_CODE_POINT
gapfuzz_10="1114112"
# 숫자 경계: tinyxml2.cpp:425 input < 0x200000
gapfuzz_11="1fffff"
# 숫자 경계: tinyxml2.cpp:425 input < 0x200000
gapfuzz_12="200000"
# 숫자 경계: tinyxml2.cpp:425 input < 0x200000
gapfuzz_13="200001"
# 숫자 경계: tinyxml2.cpp:425 input < 0x200000
gapfuzz_14="2097151"
# 숫자 경계: tinyxml2.cpp:425 input < 0x200000
gapfuzz_15="2097152"
# 숫자 경계: tinyxml2.cpp:425 input < 0x200000
gapfuzz_16="2097153"
# 숫자 경계: tinyxml2.cpp:422 input < 0x10000
gapfuzz_17="65535"
# 숫자 경계: tinyxml2.cpp:422 input < 0x10000
gapfuzz_18="65536"
# 숫자 경계: tinyxml2.cpp:422 input < 0x10000
gapfuzz_19="65537"
# 숫자 경계: tinyxml2.cpp:422 input < 0x10000
gapfuzz_20="ffff"
# 바이트: tinyxml2.cpp:400 *(pu+1) == TIXML_UTF_LEAD_1
gapfuzz_21="\xBB"
# 바이트: tinyxml2.cpp:401 *(pu+2) == TIXML_UTF_LEAD_2
gapfuzz_22="\xBF"
