# AFL dictionary for XML
# ----------------------
#
# Several basic syntax elements and attributes, modeled on libxml2.
#
# Created by Michal Zalewski <lcamtuf@google.com>
#

attr_encoding=" encoding=\"1\""
attr_generic=" a=\"1\""
attr_href=" href=\"1\""
attr_standalone=" standalone=\"no\""
attr_version=" version=\"1\""
attr_xml_base=" xml:base=\"1\""
attr_xml_id=" xml:id=\"1\""
attr_xml_lang=" xml:lang=\"1\""
attr_xml_space=" xml:space=\"1\""
attr_xmlns=" xmlns=\"1\""

entity_builtin="&lt;"
entity_decimal="&#1;"
entity_external="&a;"
entity_hex="&#x1;"

string_any="ANY"
string_brackets="[]"
string_cdata="CDATA"
string_col_fallback=":fallback"
string_col_generic=":a"
string_col_include=":include"
string_dashes="--"
string_empty="EMPTY"
string_empty_dblquotes="\"\""
string_empty_quotes="''"
string_entities="ENTITIES"
string_entity="ENTITY"
string_fixed="#FIXED"
string_id="ID"
string_idref="IDREF"
string_idrefs="IDREFS"
string_implied="#IMPLIED"
string_nmtoken="NMTOKEN"
string_nmtokens="NMTOKENS"
string_notation="NOTATION"
string_parentheses="()"
string_pcdata="#PCDATA"
string_percent="%a"
string_public="PUBLIC"
string_required="#REQUIRED"
string_schema=":schema"
string_system="SYSTEM"
string_ucs4="UCS-4"
string_utf16="UTF-16"
string_utf8="UTF-8"
string_xmlns="xmlns:"

tag_attlist="<!ATTLIST"
tag_cdata="<![CDATA["
tag_close="</a>"
tag_doctype="<!DOCTYPE"
tag_element="<!ELEMENT"
tag_entity="<!ENTITY"
tag_ignore="<![IGNORE["
tag_include="<![INCLUDE["
tag_notation="<!NOTATION"
tag_open="<a>"
tag_open_close="<a />"
tag_open_exclamation="<!"
tag_open_q="<?"
tag_sq2_close="]]>"
tag_xml_q="<?xml?>"

# --- gapfuzz가 추가한 토큰
# 숫자 경계: tinyxml2.cpp:528 digitScaled > MAX_CODE_POINT; tinyxml2.cpp:528 ucs > MAX_CODE_POINT - digitScaled; tinyxml2.cpp:533 mult > MAX_CODE_POINT
gapfuzz_1="10fffe"
# 숫자 경계: tinyxml2.cpp:528 digitScaled > MAX_CODE_POINT; tinyxml2.cpp:528 ucs > MAX_CODE_POINT - digitScaled; tinyxml2.cpp:533 mult > MAX_CODE_POINT
gapfuzz_2="10ffff"
# 숫자 경계: tinyxml2.cpp:528 digitScaled > MAX_CODE_POINT; tinyxml2.cpp:528 ucs > MAX_CODE_POINT - digitScaled; tinyxml2.cpp:533 mult > MAX_CODE_POINT
gapfuzz_3="110000"
# 숫자 경계: tinyxml2.cpp:528 digitScaled > MAX_CODE_POINT; tinyxml2.cpp:528 ucs > MAX_CODE_POINT - digitScaled; tinyxml2.cpp:533 mult > MAX_CODE_POINT
gapfuzz_4="1114110"
# 숫자 경계: tinyxml2.cpp:528 digitScaled > MAX_CODE_POINT; tinyxml2.cpp:528 ucs > MAX_CODE_POINT - digitScaled; tinyxml2.cpp:533 mult > MAX_CODE_POINT
gapfuzz_5="1114111"
# 숫자 경계: tinyxml2.cpp:528 digitScaled > MAX_CODE_POINT; tinyxml2.cpp:528 ucs > MAX_CODE_POINT - digitScaled; tinyxml2.cpp:533 mult > MAX_CODE_POINT
gapfuzz_6="1114112"
# 바이트 조합: tinyxml2.h:588 p; tinyxml2.h:588 *(p + 1) == 'x'; tinyxml2.h:588 *(p + 1) == 'X'
gapfuzz_7="0X"
# 바이트 조합: tinyxml2.h:588 p; tinyxml2.h:588 *(p + 1) == 'x'; tinyxml2.h:588 *(p + 1) == 'X'
gapfuzz_8="0x"
# 문자: tinyxml2.cpp:470 *(p + 1) == '#'
gapfuzz_9="#"
# 문자열: tinyxml2.cpp:672 TIXML_SSCANF(str, "%llx", &v) == 1
gapfuzz_10="%llx"
# 문자열: tinyxml2.cpp:603 TIXML_SSCANF(str, "%x", &v) == 1
gapfuzz_11="%x"
# 숫자 경계: tinyxml2.cpp:416 input < 0x80
gapfuzz_12="127"
# 숫자 경계: tinyxml2.cpp:416 input < 0x80
gapfuzz_13="128"
# 숫자 경계: tinyxml2.cpp:416 input < 0x80
gapfuzz_14="129"
# 숫자 경계: tinyxml2.cpp:419 input < 0x800
gapfuzz_15="2047"
# 숫자 경계: tinyxml2.cpp:419 input < 0x800
gapfuzz_16="2048"
# 숫자 경계: tinyxml2.cpp:419 input < 0x800
gapfuzz_17="2049"
# 숫자 경계: tinyxml2.cpp:416 input < 0x80
gapfuzz_18="7f"
# 숫자 경계: tinyxml2.cpp:419 input < 0x800
gapfuzz_19="7ff"
# 숫자 경계: tinyxml2.cpp:416 input < 0x80
gapfuzz_20="80"
# 숫자 경계: tinyxml2.cpp:419 input < 0x800
gapfuzz_21="800"
# 숫자 경계: tinyxml2.cpp:419 input < 0x800
gapfuzz_22="801"
# 숫자 경계: tinyxml2.cpp:416 input < 0x80
gapfuzz_23="81"
# 문자: tinyxml2.cpp:515 *q >= 'A'
gapfuzz_24="A"
# 문자: tinyxml2.cpp:515 *q <= 'F'
gapfuzz_25="F"
# 문자: tinyxml2.h:588 *(p + 1) == 'X'
gapfuzz_26="X"
# 문자: tinyxml2.h:576 ch == '_'
gapfuzz_27="_"
# 문자: tinyxml2.cpp:512 *q >= 'a'
gapfuzz_28="a"
# 문자: tinyxml2.cpp:512 *q <= 'f'
gapfuzz_29="f"
# 문자: tinyxml2.h:588 *(p + 1) == 'x'
gapfuzz_30="x"
# 바이트: tinyxml2.cpp:400 *(pu+1) == TIXML_UTF_LEAD_1
gapfuzz_31="\xBB"
# 바이트 조합: tinyxml2.cpp:400 *(pu+1) == TIXML_UTF_LEAD_1
gapfuzz_32="\xEF\xBB\xBF"
