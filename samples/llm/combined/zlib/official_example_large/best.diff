+/* 입력 앞쪽 바이트를 순서대로 하나씩 꺼낸다. 입력이 모자라면 0. */
+static uint8_t next_byte(void) { // [gapfuzz-llm] 퍼저 입력에서 인자 값을 겹치지 않게 꺼내는 도우미
